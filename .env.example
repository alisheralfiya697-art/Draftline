# PORT: HTTP port for the Express + Vite server (default: 3000)
PORT=3000

# DATA_DIR: Directory for persistent SQLite storage (draftline.db).
# In production, mount a persistent disk/volume and point DATA_DIR to it (e.g. /data).
DATA_DIR="./data"

# APP_URL: Public URL where the deployed application is hosted.
APP_URL="http://localhost:3000"
